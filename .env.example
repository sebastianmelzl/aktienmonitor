# ---------------------------------------------------------------------------
# Aktienmonitor - Konfiguration
# Diese Datei nach ".env" kopieren und die Werte eintragen:
#   cp .env.example .env
# Die .env-Datei wird von .gitignore ausgeschlossen und darf niemals
# committet werden.
# ---------------------------------------------------------------------------

# --- Finnhub (optional, empfohlen) -----------------------------------------
# Kostenloser Key ohne Kreditkarte: https://finnhub.io/register
# Free-Tier: 60 Calls/Minute. Deckt Realtime-Quote, Firmenprofil,
# Basis-Kennzahlen und Unternehmens-News ab - im Wesentlichen fuer US-Titel.
# Historische Kurse, Analystendaten und News-Sentiment sind im Free-Tier
# gesperrt (HTTP 403). Ohne Key laeuft die App vollstaendig ueber yfinance.
FINNHUB_API_KEY=

# --- Anthropic (optional) ---------------------------------------------------
# Nur fuer die Sentiment-Einordnung der Schlagzeilen (Phase 4).
# Key erstellen: https://console.anthropic.com/settings/keys
# Ohne Key bleibt der Sentiment-Score "n/a" und sein Gewicht wird auf die
# uebrigen Teilscores umverteilt - es wird kein Ersatzwert erfunden.
ANTHROPIC_API_KEY=

# --- Datenhaltung -----------------------------------------------------------
# Pfad zur lokalen SQLite-Datenbank (relativ zum Projektverzeichnis).
AKTIENMONITOR_DB_PATH=data/aktienmonitor.db

# Log-Level: DEBUG, INFO, WARNING, ERROR
AKTIENMONITOR_LOG_LEVEL=INFO

# --- Cache-Lebensdauer (TTL) in Sekunden ------------------------------------
# Kursdaten kurz, Fundamentaldaten lang. Im UI unter "Einstellungen"
# veraenderbar; die Werte hier sind die Startvorgaben.
CACHE_TTL_QUOTE=300           # Realtime-Kurs: 5 Minuten
CACHE_TTL_PRICE_HISTORY=21600 # Kurshistorie (Tageskerzen): 6 Stunden
CACHE_TTL_FUNDAMENTALS=604800 # Bilanz/GuV/Cashflow: 7 Tage
CACHE_TTL_PROFILE=2592000     # Firmenprofil, Sektor: 30 Tage
CACHE_TTL_ANALYST=86400       # Analystendaten: 1 Tag
CACHE_TTL_NEWS=3600           # Schlagzeilen: 1 Stunde

# --- Rate-Limiting ----------------------------------------------------------
# Maximale Requests pro Minute je Quelle (Token-Bucket).
# Finnhub Free erlaubt 60/min - der Vorgabewert laesst Puffer.
RATE_LIMIT_FINNHUB_PER_MIN=50
RATE_LIMIT_YFINANCE_PER_MIN=60

# Anzahl der Wiederholversuche bei Netzwerkfehlern bzw. HTTP 429/5xx
RETRY_MAX_ATTEMPTS=4
